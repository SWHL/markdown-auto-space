{
  "publisher": "SWHL",
  "name": "markdown-auto-space",
  "displayName": "Markdown Auto Space",
  "version": "0.0.9",
  "private": true,
  "packageManager": "pnpm@9.14.1",
  "description": "Auto add space between Chinese and English in Markdown when you save file",
  "author": "SWHL<liekkaskono@163.com>",
  "license": "MIT",
  "homepage": "https://github.com/SWHL/markdown-auto-space",
  "repository": {
    "type": "git",
    "url": "https://github.com/SWHL/markdown-auto-space.git"
  },
  "bugs": {
    "url": "https://github.com/SWHL/markdown-auto-space.git/issues"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/index.js",
  "browser": "./dist/web/extension.js",
  "icon": "res/icon.png",
  "engines": {
    "vscode": "^1.69.0"
  },
  "activationEvents": [
    "onLanguage:markdown",
    "onCommand:extension.markdownAutoSpace",
    "onCommand:extension.markdownAutoSpacePreview"
  ],
  "contributes": {
    "commands": [
      {
        "command": "extension.markdownAutoSpace",
        "title": "Markdown Auto Space: Format Document",
        "icon": "$(symbol-misc)"
      },
      {
        "command": "extension.markdownAutoSpacePreview",
        "title": "Markdown Auto Space: Preview Changes",
        "icon": "$(diff)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "extension.markdownAutoSpace",
          "when": "editorLangId == markdown"
        },
        {
          "command": "extension.markdownAutoSpacePreview",
          "when": "editorLangId == markdown"
        }
      ],
      "editor/title": [
        {
          "command": "extension.markdownAutoSpace",
          "when": "editorLangId == markdown",
          "group": "1_modification"
        },
        {
          "command": "extension.markdownAutoSpacePreview",
          "when": "editorLangId == markdown",
          "group": "1_modification"
        }
      ],
      "editor/context": [
        {
          "command": "extension.markdownAutoSpace",
          "when": "editorLangId == markdown",
          "group": "1_modification"
        },
        {
          "command": "extension.markdownAutoSpacePreview",
          "when": "editorLangId == markdown",
          "group": "1_modification"
        }
      ]
    },
    "configuration": {
      "title": "Markdown Auto Space configuration",
      "properties": {
        "markdownAutoSpace.diagnostics.enable": {
          "type": "boolean",
          "default": true,
          "description": "Show diagnostics where spacing rules are violated (for example, MAS001)."
        },
        "markdownAutoSpace.formatOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Apply space rules when you manually save (e.g. Ctrl+S). Does not run on auto-save, so diagnostics (squiggles) stay until you save."
        },
        "markdownAutoSpace.formatOnDocument": {
          "type": "boolean",
          "default": false,
          "description": "Apply spacing rules when the Format Document command runs."
        },
        "markdownAutoSpace.exclude": {
          "type": "array",
          "default": [],
          "scope": "resource",
          "items": {
            "type": "string"
          },
          "description": "Glob patterns for Markdown files to ignore. Patterns are relative to the containing workspace folder (including each root in a multi-root workspace); outside a workspace, they match the document path."
        },
        "markdownAutoSpace.rules": {
          "type": "object",
          "description": "Enable or disable each space rule by code (MAS001–MAS009). All default to true. See docs/RULES.md.",
          "properties": {
            "MAS001": {
              "type": "boolean",
              "default": true,
              "description": "Add spaces between Chinese and English or numbers."
            },
            "MAS002": {
              "type": "boolean",
              "default": true,
              "description": "Add spaces between Chinese text and inline code."
            },
            "MAS003": {
              "type": "boolean",
              "default": true,
              "description": "Add spaces between Chinese text and links or URLs."
            },
            "MAS004": {
              "type": "boolean",
              "default": true,
              "description": "Replace enumeration commas between English or numbers with comma-space."
            },
            "MAS005": {
              "type": "boolean",
              "default": true,
              "description": "Add spaces around slashes next to Chinese text."
            },
            "MAS006": {
              "type": "boolean",
              "default": true,
              "description": "Add spaces around English text mixed with Chinese inside link text."
            },
            "MAS007": {
              "type": "boolean",
              "default": true,
              "description": "Add spaces between numbers and units."
            },
            "MAS008": {
              "type": "boolean",
              "default": true,
              "description": "Remove spaces between numbers and degree or percent signs."
            },
            "MAS009": {
              "type": "boolean",
              "default": true,
              "description": "Remove spaces around full-width punctuation."
            }
          }
        },
        "markdownAutoSpace.units": {
          "type": "object",
          "default": {
            "additional": [],
            "exclude": []
          },
          "description": "Customize MAS007 units. Additional units are appended to defaults; excluded units are removed.",
          "properties": {
            "additional": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "include": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "exclude": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            }
          }
        }
      }
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --external vscode",
    "build:web": "node scripts/build-web.mjs",
    "dev": "pnpm build --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "package:vsix": "vsce package --no-dependencies",
    "version:sync": "node scripts/sync-version.mjs",
    "version:check": "node scripts/check-version.mjs",
    "vscode:prepublish": "pnpm build && pnpm build:web",
    "publish": "vsce publish --no-dependencies",
    "test": "vitest run test/index.test.ts test/save-flow.test.ts",
    "test:integration": "vitest run test/save-flow.test.ts",
    "test:smoke": "pnpm build && pnpm build:web && vitest run test/build-smoke.test.ts",
    "typecheck": "tsc --noEmit",
    "release": "bumpp && pnpm run publish"
  },
  "devDependencies": {
    "@types/node": "^22.9.1",
    "@types/vscode": "^1.69.0",
    "@vscode/vsce": "^3.2.1",
    "bumpp": "^9.8.1",
    "esbuild": "^0.24.0",
    "eslint": "9.14.0",
    "pnpm": "^9.14.1",
    "rimraf": "^6.0.1",
    "talljack-eslint-config": "^0.2.6",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "eslint": "9"
      }
    },
    "overrides": {
      "jwa": ">=1.4.2"
    },
    "patchedDependencies": {
      "buffer-equal-constant-time@1.0.1": "patches/buffer-equal-constant-time@1.0.1.patch"
    }
  }
}
